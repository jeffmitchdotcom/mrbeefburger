---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';
---

<Layout title="Contact — Mr. Beefburger">
  <main>

    <section class="page-hero">
      <div class="page-hero-inner">
        <h1 class="page-title">Get in Touch</h1>
        <p class="page-sub">Questions, feedback, sauce theories, life advice — Gerald's team reads it all.</p>
      </div>
    </section>

    <section class="contact-body">
      <div class="contact-inner">
        <ContactForm client:load />
      </div>
    </section>

  </main>
</Layout>

<style>
  .page-hero {
    background-color: var(--color-surface);
    background-image: url('/images/mrbeefburger-hero-1.jpg');
    background-size: cover;
    background-position: center;
    position: relative;
    padding: 4rem 1.5rem;
    border-bottom: 1px solid rgba(218, 41, 28, 0.15);
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-surface);
    opacity: 0.85;
  }

  .page-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--color-red);
    margin: 0 0 0.5rem;
    line-height: 1;
  }

  .page-sub {
    font-size: 1.0625rem;
    color: var(--color-muted);
    font-style: italic;
    margin: 0;
  }

  .contact-body {
    padding: 5rem 1.5rem;
    background-color: var(--color-bg);
  }

  .contact-inner {
    max-width: 720px;
    margin: 0 auto;
  }
</style>
