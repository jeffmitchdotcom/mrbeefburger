---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { auth } from '../lib/auth';
import { db } from '../lib/db';
import { orders, loyaltyMembers, loyaltyTransactions } from '../lib/schema';
import { desc, eq, sum } from 'drizzle-orm';

const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session?.user) return Astro.redirect('/account');
if (!session.user.email.endsWith('@mrbeefburger.com')) return new Response('Forbidden', { status: 403 });

const allOrders = await db.select().from(orders).orderBy(desc(orders.createdAt));

const allMembers = await db
  .select({
    id: loyaltyMembers.id,
    name: loyaltyMembers.name,
    email: loyaltyMembers.email,
    city: loyaltyMembers.city,
    preferredBurger: loyaltyMembers.preferredBurger,
    beefRelationship: loyaltyMembers.beefRelationship,
    wellDone: loyaltyMembers.wellDone,
    tier: loyaltyMembers.tier,
    createdAt: loyaltyMembers.createdAt,
    balance: sum(loyaltyTransactions.sauceUnits),
  })
  .from(loyaltyMembers)
  .leftJoin(loyaltyTransactions, eq(loyaltyTransactions.memberId, loyaltyMembers.id))
  .groupBy(loyaltyMembers.id)
  .orderBy(desc(loyaltyMembers.createdAt));

function orderTotal(items: { price: number; quantity: number }[]) {
  return items.reduce((s, i) => s + i.price * i.quantity, 0);
}

function fmt(date: Date | null | undefined) {
  if (!date) return '—';
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
}

const totalRevenue = allOrders.reduce((s, o) => s + orderTotal(o.items as { price: number; quantity: number }[]), 0);
---

<Layout title="Admin — Mr. Beefburger">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <main>
    <div class="admin-wrap">

      <div class="admin-header">
        <h1 class="admin-title">Admin</h1>
        <a href="https://vercel.com/jeffmitchdotcom/mrbeefburger/analytics" target="_blank" rel="noopener" class="analytics-link">
          View Vercel Analytics →
        </a>
      </div>

      <div class="stats-row">
        <div class="stat-card">
          <div class="stat-value">{allOrders.length}</div>
          <div class="stat-label">Orders</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">${totalRevenue.toFixed(2)}</div>
          <div class="stat-label">Total Revenue</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">{allMembers.length}</div>
          <div class="stat-label">Accord Members</div>
        </div>
      </div>

      <!-- Orders -->
      <section class="table-section">
        <h2 class="section-title">Orders</h2>
        {allOrders.length === 0 ? (
          <p class="empty">No orders yet.</p>
        ) : (
          <>
            <div class="table-scroll">
              <table id="orders-table">
                <thead>
                  <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Email</th>
                    <th>Location</th>
                    <th>Type</th>
                    <th>Items</th>
                    <th class="col-right">Total</th>
                  </tr>
                </thead>
                <tbody id="orders-tbody">
                  {allOrders.map(o => {
                    const items = o.items as { title: string; price: number; quantity: number }[];
                    const itemCount = items.reduce((s, i) => s + i.quantity, 0);
                    return (
                      <tr>
                        <td class="mono">
                          <a href={`/order/${o.orderNumber}`} class="order-link">{o.orderNumber}</a>
                        </td>
                        <td class="nowrap">{fmt(o.createdAt)}</td>
                        <td>{o.customerName}</td>
                        <td class="muted">{o.customerEmail ?? '—'}</td>
                        <td>{o.locationName}</td>
                        <td class="nowrap">{o.orderType}</td>
                        <td>{itemCount}</td>
                        <td class="col-right mono">${orderTotal(items).toFixed(2)}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
            <div id="orders-pagination" class="pagination"></div>
          </>
        )}
      </section>

      <!-- Loyalty Members -->
      <section class="table-section">
        <h2 class="section-title">Accord Members</h2>
        {allMembers.length === 0 ? (
          <p class="empty">No members yet.</p>
        ) : (
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>City</th>
                  <th>Tier</th>
                  <th class="col-right">SU Balance</th>
                  <th>Joined</th>
                </tr>
              </thead>
              <tbody>
                {allMembers.map(m => (
                  <tr
                    class="member-row"
                    data-member={JSON.stringify({
                      id: m.id,
                      name: m.name,
                      email: m.email,
                      city: m.city,
                      preferredBurger: m.preferredBurger,
                      beefRelationship: m.beefRelationship,
                      wellDone: m.wellDone,
                      tier: m.tier,
                      balance: Number(m.balance ?? 0),
                      joined: fmt(m.createdAt),
                    })}
                  >
                    <td>{m.name}</td>
                    <td class="muted">{m.email}</td>
                    <td>{m.city}</td>
                    <td><span class="tier-badge">{m.tier}</span></td>
                    <td class="col-right mono">{Number(m.balance ?? 0)}</td>
                    <td class="nowrap muted">{fmt(m.createdAt)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

    </div>
  </main>

  <!-- Member detail modal -->
  <div id="member-overlay" class="member-overlay" aria-hidden="true">
    <div class="member-modal" role="dialog" aria-modal="true" aria-labelledby="modal-name">
      <button id="modal-close" class="modal-close" aria-label="Close">✕</button>
      <h2 id="modal-name" class="modal-name"></h2>
      <p class="modal-meta"></p>
      <dl class="modal-fields">
        <div class="modal-field">
          <dt>Preferred Burger</dt>
          <dd id="modal-burger"></dd>
        </div>
        <div class="modal-field">
          <dt>Relationship with Beef</dt>
          <dd id="modal-beef"></dd>
        </div>
        <div class="modal-field">
          <dt>Well Done?</dt>
          <dd id="modal-welldone"></dd>
        </div>
      </dl>
      <div class="modal-footer">
        <button id="modal-delete" class="modal-delete-btn">Delete Member</button>
        <span id="modal-delete-msg" class="modal-delete-msg"></span>
      </div>
    </div>
  </div>
</Layout>

<style>
  .admin-wrap {
    max-width: 1300px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .admin-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .admin-title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-red);
    margin: 0;
  }

  .analytics-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.2s;
  }

  .analytics-link:hover {
    color: var(--color-red);
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .stat-card {
    background: var(--color-surface);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text);
    line-height: 1;
    margin-bottom: 0.35rem;
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .table-section {
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }

  .table-scroll {
    overflow-x: auto;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  thead {
    background: var(--color-surface);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  th {
    padding: 0.75rem 1rem;
    text-align: left;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
  }

  td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    color: var(--color-text);
    vertical-align: middle;
  }

  tr:last-child td {
    border-bottom: none;
  }

  tr:hover td {
    background: rgba(0, 0, 0, 0.015);
  }

  .col-right {
    text-align: right;
  }

  .mono {
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum";
  }

  .nowrap {
    white-space: nowrap;
  }

  .muted {
    color: var(--color-muted);
  }

  .order-link {
    color: var(--color-red);
    text-decoration: none;
    font-weight: 600;
  }

  .order-link:hover {
    text-decoration: underline;
  }

  .tier-badge {
    font-size: 0.75rem;
    font-weight: 600;
    background: #fff8e0;
    color: #7a5c00;
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    white-space: nowrap;
  }

  .empty {
    color: var(--color-muted);
    font-style: italic;
    margin: 0;
  }

  .pagination {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.8rem;
    font-family: var(--font-body);
  }

  .pagination button {
    background: none;
    border: 1.5px solid rgba(0, 0, 0, 0.12);
    border-radius: 6px;
    padding: 0.35rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    color: var(--color-text);
    font-family: var(--font-body);
    transition: border-color 0.15s, color 0.15s;
  }

  .pagination button:hover:not(:disabled) {
    border-color: var(--color-red);
    color: var(--color-red);
  }

  .pagination button:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .pagination button.active {
    background: var(--color-red);
    border-color: var(--color-red);
    color: #ffffff;
  }

  .pagination-info {
    color: var(--color-muted);
    margin-left: auto;
  }

  .member-row {
    cursor: pointer;
  }

  .member-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 200;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .member-overlay.open {
    display: flex;
  }

  .member-modal {
    background: #ffffff;
    border-radius: 12px;
    padding: 2rem;
    max-width: 520px;
    width: 100%;
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1rem;
    cursor: pointer;
    color: var(--color-muted);
    padding: 0.25rem 0.5rem;
    line-height: 1;
    transition: color 0.15s;
  }

  .modal-close:hover {
    color: var(--color-red);
  }

  .modal-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-red);
    margin: 0 0 0.25rem;
    padding-right: 2rem;
  }

  .modal-meta {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin: 0 0 1.5rem;
  }

  .modal-fields {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .modal-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .modal-field dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .modal-field dd {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .modal-footer {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .modal-delete-btn {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
    background: var(--color-red);
    border: none;
    border-radius: 6px;
    padding: 0.6rem 1.25rem;
    cursor: pointer;
    transition: background-color 0.15s;
  }

  .modal-delete-btn:hover {
    background: #b82018;
  }

  .modal-delete-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .modal-delete-msg {
    font-size: 0.8rem;
    color: var(--color-muted);
    font-style: italic;
  }

  @media (max-width: 600px) {
    .stats-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const PAGE_SIZE = 25;
  const tbody = document.getElementById('orders-tbody') as HTMLTableSectionElement | null;
  const container = document.getElementById('orders-pagination') as HTMLDivElement | null;

  if (tbody && container) {
    const pager = container;
    const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr'));
    const totalPages = Math.ceil(rows.length / PAGE_SIZE);
    let currentPage = 1;

    function showPage(page: number) {
      currentPage = page;
      rows.forEach((row, i) => {
        row.style.display = (i >= (page - 1) * PAGE_SIZE && i < page * PAGE_SIZE) ? '' : 'none';
      });
      // Remove bottom border from the last visible row
      rows.forEach(row => row.querySelectorAll('td').forEach(td => td.style.borderBottom = ''));
      const visible = rows.filter(r => r.style.display !== 'none');
      if (visible.length) {
        visible[visible.length - 1].querySelectorAll('td').forEach(td => td.style.borderBottom = 'none');
      }
      renderControls();
    }

    function renderControls() {
      if (totalPages <= 1) return;
      pager.innerHTML = '';

      const prev = document.createElement('button');
      prev.textContent = '← Prev';
      prev.disabled = currentPage === 1;
      prev.addEventListener('click', () => showPage(currentPage - 1));
      pager.appendChild(prev);

      for (let p = 1; p <= totalPages; p++) {
        const btn = document.createElement('button');
        btn.textContent = String(p);
        if (p === currentPage) btn.classList.add('active');
        btn.addEventListener('click', () => showPage(p));
        pager.appendChild(btn);
      }

      const next = document.createElement('button');
      next.textContent = 'Next →';
      next.disabled = currentPage === totalPages;
      next.addEventListener('click', () => showPage(currentPage + 1));
      pager.appendChild(next);

      const info = document.createElement('span');
      info.className = 'pagination-info';
      const start = (currentPage - 1) * PAGE_SIZE + 1;
      const end = Math.min(currentPage * PAGE_SIZE, rows.length);
      info.textContent = `${start}–${end} of ${rows.length}`;
      pager.appendChild(info);
    }

    showPage(1);
  }
</script>

<script>
  const overlay = document.getElementById('member-overlay')!;
  const closeBtn = document.getElementById('modal-close')!;
  const deleteBtn = document.getElementById('modal-delete') as HTMLButtonElement;
  const deleteMsg = document.getElementById('modal-delete-msg')!;

  let activeMemberId: number | null = null;
  let activeRow: HTMLTableRowElement | null = null;

  function openModal(data: {
    id: number; name: string; email: string; city: string; tier: string;
    preferredBurger: string; beefRelationship: string; wellDone: string;
    balance: number; joined: string;
  }, row: HTMLTableRowElement) {
    activeMemberId = data.id;
    activeRow = row;
    deleteBtn.disabled = false;
    deleteMsg.textContent = '';
    (document.getElementById('modal-name') as HTMLElement).textContent = data.name;
    (document.querySelector('.modal-meta') as HTMLElement).textContent =
      `${data.email} · ${data.city} · ${data.tier} · ${data.balance} SU · Joined ${data.joined}`;
    (document.getElementById('modal-burger') as HTMLElement).textContent = data.preferredBurger;
    (document.getElementById('modal-beef') as HTMLElement).textContent = data.beefRelationship;
    (document.getElementById('modal-welldone') as HTMLElement).textContent = data.wellDone;
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
  }

  function closeModal() {
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    activeMemberId = null;
    activeRow = null;
  }

  deleteBtn.addEventListener('click', async () => {
    if (!activeMemberId) return;
    const confirmed = confirm('Delete this member and all their Sauce Unit history? This cannot be undone.');
    if (!confirmed) return;
    deleteBtn.disabled = true;
    deleteMsg.textContent = 'Deleting…';
    try {
      const res = await fetch(`/api/admin/loyalty/${activeMemberId}`, { method: 'DELETE' });
      if (!res.ok) throw new Error();
      activeRow?.remove();
      closeModal();
    } catch {
      deleteBtn.disabled = false;
      deleteMsg.textContent = 'Something went wrong. Try again.';
    }
  });

  document.querySelectorAll<HTMLTableRowElement>('.member-row').forEach(row => {
    row.addEventListener('click', () => {
      const data = JSON.parse(row.dataset.member!);
      openModal(data, row);
    });
  });

  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
</script>
