---
export const prerender = false;

import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import OrderForm from '../components/OrderForm.tsx';
import { auth } from '../lib/auth';

const session = await auth.api.getSession({ headers: Astro.request.headers });
const user = session?.user ? { name: session.user.name, email: session.user.email } : null;

const allLocations = await getCollection('locations');
const locations = allLocations.map(l => ({
  slug: l.id,
  name: l.data.name,
  address: `${l.data.address}, ${l.data.city}, ${l.data.state}`,
  hours: l.data.hours,
  lat: l.data.lat,
  lng: l.data.lng,
  state: l.data.state,
}));
---

<Layout title="Place Your Order — Mr. Beefburger">
  <OrderForm locations={locations} user={user} client:load />
</Layout>
