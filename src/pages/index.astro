---
import Layout from '../layouts/Layout.astro';

const categories = [
  {
    label: 'Burgers',
    href: '/menu',
    icon: `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M12 28 Q12 20 32 20 Q52 20 52 28 Z" fill="#DA291C"/>
      <rect x="10" y="29" width="44" height="5" rx="1" fill="#DA291C"/>
      <rect x="10" y="35" width="44" height="5" rx="1" fill="#DA291C"/>
      <path d="M10 41 Q10 46 32 46 Q54 46 54 41 Z" fill="#DA291C"/>
      <path d="M14 28 Q18 22 32 22 Q46 22 50 28" stroke="#F5C200" stroke-width="2" fill="none"/>
    </svg>`,
  },
  {
    label: 'Fries',
    href: '/menu',
    icon: `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M18 44 L22 24 H42 L46 44 Z" fill="#DA291C"/>
      <rect x="24" y="14" width="4" height="14" rx="2" fill="#DA291C"/>
      <rect x="30" y="11" width="4" height="17" rx="2" fill="#DA291C"/>
      <rect x="36" y="14" width="4" height="14" rx="2" fill="#DA291C"/>
      <path d="M20 34 L44 34" stroke="#F5C200" stroke-width="1.5"/>
    </svg>`,
  },
  {
    label: 'Shakes & Drinks',
    href: '/menu',
    icon: `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M22 22 L26 50 H38 L42 22 Z" fill="#DA291C"/>
      <rect x="20" y="18" width="24" height="6" rx="2" fill="#DA291C"/>
      <path d="M28 18 Q26 12 28 10 Q30 8 32 10 Q34 8 36 10 Q38 12 36 18" fill="#F5C200"/>
      <line x1="34" y1="14" x2="44" y2="10" stroke="#DA291C" stroke-width="2" stroke-linecap="round"/>
    </svg>`,
  },
  {
    label: 'Extras',
    href: '/menu',
    icon: `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M32 14 L35.5 25 H47 L37.7 31.8 L41.2 43 L32 36.2 L22.8 43 L26.3 31.8 L17 25 H28.5 Z" fill="#DA291C"/>
      <circle cx="32" cy="32" r="4" fill="#F5C200"/>
    </svg>`,
  },
];
---

<Layout>
  <main>

    <!-- Hero -->
    <section class="hero">
      <div class="hero-inner">
        <h1 class="hero-title">Home of the Meaty Faced Sauce Burger</h1>
        <a href="/menu" class="btn btn-hero">See the Menu</a>
      </div>
    </section>

    <!-- Menu Category Icons -->
    <section class="categories">
      <div class="section-inner">
        <p class="categories-label">Explore the Menu</p>
        <div class="category-grid">
          {categories.map(cat => (
            <a href={cat.href} class="category-tile">
              <div class="category-icon" set:html={cat.icon} />
              <span class="category-label">{cat.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Burger -->
    <section class="featured">
      <div class="section-inner featured-inner">
        <img
          src="/images/meaty-faced-sauce-burger.webp"
          alt="The Meaty Faced Sauce Burger"
          class="featured-img"
        />
        <div class="featured-text">
          <p class="featured-eyebrow">Our Signature</p>
          <h2 class="featured-title">The Meaty Faced Sauce Burger</h2>
          <p class="featured-desc">
            Two smashed patties, melted cheddar, house meaty sauce dripping down every layer.
            This is what we do. This is why we exist.
          </p>
          <a href="/menu" class="btn btn-primary">Order Now</a>
        </div>
      </div>
    </section>

    <!-- More from the Menu -->
    <section class="signatures">
      <div class="section-inner">
        <h2 class="section-heading">More from the Menu</h2>
        <div class="sig-grid">
          <a href="/menu" class="sig-card">
            <img src="/images/ranchero-chicken.webp" alt="Ranchero Chicken Sandwich" class="sig-img" />
            <div class="sig-body">
              <h3 class="sig-name">Ranchero Chicken Sandwich</h3>
              <p class="sig-desc">Crispy chicken, curly onion straws, ranch drizzle. Placeholder copy coming soon.</p>
            </div>
          </a>
          <a href="/menu" class="sig-card">
            <img src="/images/bacon-swiss.webp" alt="Bacon Swiss Burger" class="sig-img" />
            <div class="sig-body">
              <h3 class="sig-name">Bacon Swiss Burger</h3>
              <p class="sig-desc">Swiss melt, crispy bacon, onion rings stacked high. Placeholder copy coming soon.</p>
            </div>
          </a>
          <a href="/menu" class="sig-card">
            <img src="/images/patty-melt.webp" alt="Patty Melt" class="sig-img" />
            <div class="sig-body">
              <h3 class="sig-name">Patty Melt</h3>
              <p class="sig-desc">Griddled sourdough, caramelized onions, Swiss. A classic done right. Placeholder copy coming soon.</p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Locations Teaser -->
    <section class="locations-teaser">
      <div class="section-inner">
        <h2 class="locations-heading">Find Us</h2>
        <p class="locations-copy">Now open in cities near you. Placeholder location copy goes here.</p>
        <a href="/locations" class="btn btn-outline">Find a Location</a>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* ── Hero ─────────────────────────────────── */
  .hero {
    position: relative;
    background-image: url('/images/mrbeefburger-hero-image.webp');
    background-size: cover;
    background-position: center;
    min-height: 82vh;
    display: flex;
    align-items: flex-end;
  }

  /* Dark gradient up from bottom for text legibility */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.72) 0%,
      rgba(0, 0, 0, 0.35) 35%,
      transparent 65%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 3rem 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.75rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.1;
    max-width: 600px;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.5);
  }

  .btn-hero {
    display: inline-block;
    padding: 0.9rem 2.25rem;
    background-color: var(--color-red);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    border: 2px solid var(--color-red);
    transition: background-color 0.2s, color 0.2s;
    white-space: nowrap;
  }

  .btn-hero:hover {
    background-color: transparent;
    color: #ffffff;
    border-color: #ffffff;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 75vh;
      background-position: center top;
    }

    .hero-inner {
      padding: 0 1.5rem 2.5rem;
      gap: 1.25rem;
    }

    .hero-title {
      max-width: 100%;
    }
  }

  /* ── Category Icons ───────────────────────── */
  .categories {
    background-color: var(--color-bg);
    padding: 4rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .categories-label {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: center;
    margin: 0 0 2.5rem;
  }

  .category-grid {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .category-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: transform 0.2s;
  }

  .category-tile:hover {
    transform: translateY(-4px);
  }

  .category-icon {
    width: 96px;
    height: 96px;
    background-color: var(--color-yellow);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
    transition: background-color 0.2s;
  }

  .category-tile:hover .category-icon {
    background-color: var(--color-red);
  }

  .category-tile:hover .category-icon :global(svg path),
  .category-tile:hover .category-icon :global(svg rect),
  .category-tile:hover .category-icon :global(svg circle) {
    fill: var(--color-yellow);
  }

  .category-tile:hover .category-icon :global(svg line),
  .category-tile:hover .category-icon :global(svg path[stroke]) {
    stroke: var(--color-yellow);
  }

  .category-label {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  /* ── Featured Burger ──────────────────────── */
  .featured {
    background-color: var(--color-surface);
    padding: 5rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .featured-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .featured-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }

  .featured-eyebrow {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-red);
    margin: 0 0 0.75rem;
  }

  .featured-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  .featured-desc {
    font-size: 1rem;
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0 0 2rem;
  }

  /* ── Signatures ──────────────────────────── */
  .signatures {
    background-color: var(--color-bg);
    padding: 5rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 2.5rem;
  }

  .sig-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .sig-card {
    text-decoration: none;
    background-color: var(--color-surface);
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.06);
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .sig-card:hover {
    box-shadow: 0 8px 24px rgba(218, 41, 28, 0.12);
    transform: translateY(-3px);
  }

  .sig-img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .sig-body {
    padding: 1.25rem;
  }

  .sig-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .sig-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Locations Teaser ─────────────────────── */
  .locations-teaser {
    background-color: var(--color-bg);
    padding: 5rem 0;
    text-align: center;
  }

  .locations-heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-red);
    margin: 0 0 0.75rem;
  }

  .locations-copy {
    font-size: 1.0625rem;
    color: var(--color-muted);
    margin: 0 auto 2rem;
    max-width: 480px;
  }

  /* ── Shared utilities ─────────────────────── */
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2.25rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    border: 2px solid var(--color-red);
    transition: background-color 0.2s, color 0.2s;
    white-space: nowrap;
  }

  .btn-primary {
    background-color: var(--color-red);
    color: #ffffff;
  }

  .btn-primary:hover {
    background-color: transparent;
    color: var(--color-red);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--color-red);
  }

  .btn-outline:hover {
    background-color: var(--color-red);
    color: #ffffff;
  }

  /* ── Responsive ───────────────────────────── */
  @media (max-width: 768px) {
    .featured-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
      justify-items: center;
    }

    .sig-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
