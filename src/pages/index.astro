---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allMenu = await getCollection('menu');
const homepageItems = allMenu
  .filter(i => i.data.homepage === true && i.data.available !== false)
  .slice(0, 3);

const categories = [
  {
    label: 'Burgers',
    href: '/menu#burgers',
    icon: `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M12 28 Q12 20 32 20 Q52 20 52 28 Z" fill="#DA291C"/>
      <rect x="10" y="29" width="44" height="5" rx="1" fill="#DA291C"/>
      <rect x="10" y="35" width="44" height="5" rx="1" fill="#DA291C"/>
      <path d="M10 41 Q10 46 32 46 Q54 46 54 41 Z" fill="#DA291C"/>
      <path d="M14 28 Q18 22 32 22 Q46 22 50 28" stroke="#F5C200" stroke-width="2" fill="none"/>
    </svg>`,
  },
  {
    label: 'Sides',
    href: '/menu#sides',
    icon: `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M18 24 L22 44 H42 L46 24 Z" fill="#DA291C"/>
      <rect x="21" y="17" width="4" height="11" rx="2" fill="#DA291C"/>
      <rect x="27" y="10" width="4" height="18" rx="2" fill="#DA291C"/>
      <rect x="33" y="15" width="4" height="13" rx="2" fill="#DA291C"/>
      <rect x="39" y="8" width="4" height="20" rx="2" fill="#DA291C"/>
      <path d="M20 34 L44 34" stroke="#F5C200" stroke-width="1.5"/>
    </svg>`,
  },
  {
    label: 'Drinks',
    href: '/menu#drinks',
    icon: `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M20 24 L26 50 H38 L44 24 Z" fill="#DA291C"/>
      <rect x="18" y="19" width="28" height="6" rx="3" fill="#DA291C"/>
      <line x1="34" y1="19" x2="38" y2="3" stroke="#DA291C" stroke-width="3" stroke-linecap="round"/>
    </svg>`,
  },
  {
    label: 'Extras',
    href: '/menu#extras',
    icon: `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M32 15 L36.7 25.5 L48.2 26.8 L39.6 34.5 L42 45.8 L32 40 L22 45.8 L24.4 34.5 L15.8 26.8 L27.3 25.5 Z" fill="#DA291C" stroke="#F5C200" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>`,
  },
];
---

<Layout>
  <main>

    <!-- Hero -->
    <section class="hero">
      <div class="hero-slides">
        <div class="hero-slide active" style="background-image: url('/images/mrbeefburger-hero-1.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/mrbeefburger-hero-2.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/mrbeefburger-hero-3.jpg')"></div>
      </div>
      <div class="hero-inner reveal">
        <h1 class="hero-title">
          <span class="hero-overline">Home of the</span>
          <span class="hero-headline">Meaty Faced Sauce Burger</span>
        </h1>
        <a href="/menu" class="btn btn-hero">See the Menu</a>
      </div>
      <div class="hero-dots-rail">
        <div class="hero-dots">
          <button class="hero-dot active" aria-label="Slide 1"></button>
          <button class="hero-dot" aria-label="Slide 2"></button>
          <button class="hero-dot" aria-label="Slide 3"></button>
        </div>
      </div>
    </section>

    <!-- Menu Category Icons -->
    <section class="categories">
      <div class="section-inner">
        <h2 class="categories-label reveal">Explore the Menu</h2>
        <div class="category-grid">
          {categories.map((cat, i) => (
            <a href={cat.href} class="category-tile reveal" style={`--reveal-delay: ${i * 80}ms`}>
              <div class="category-icon" set:html={cat.icon} />
              <span class="category-label">{cat.label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Burger -->
    <section class="featured">
      <svg class="featured-wave" viewBox="0 0 1600 60" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,0 L1600,0 L1600,30 C1000,15 500,5 0,45 L0,0 Z" fill="var(--color-bg)"/>
      </svg>
      <div class="section-inner featured-inner">
        <img
          src="/images/menu/the-meaty-faced-sauce-burger.jpg"
          alt="The Meaty Faced Sauce Burger"
          class="featured-img reveal-left"
        />
        <div class="featured-text reveal-right">
          <p class="featured-eyebrow">Our Signature</p>
          <h2 class="featured-title">The Meaty Faced Sauce Burger</h2>
          <p class="featured-desc">
            Two smashed patties, melted cheddar, house meaty sauce dripping down every layer.
            This is what we do. This is why we exist.
          </p>
          <a href="/menu" class="btn btn-primary">Order Now</a>
        </div>
      </div>
    </section>

    <!-- More from the Menu -->
    <section class="signatures">
      <div class="section-inner">
        <h2 class="section-heading reveal">More from the Menu</h2>
        <div class="sig-grid">
          {homepageItems.map((item, i) => (
            <a href="/menu" class="sig-card reveal" style={`--reveal-delay: ${i * 100}ms`}>
              {item.data.image && (
                <img src={item.data.image} alt={item.data.title} class="sig-img" />
              )}
              <div class="sig-body">
                <h3 class="sig-name">{item.data.title}</h3>
                <p class="sig-desc">{item.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Locations Teaser -->
    <section class="locations-teaser">
      <div class="section-inner locations-inner">
        <div class="locations-img-wrap reveal-left">
          <img
            src="/images/mrbeefburger-exterior.jpg"
            alt="Mr. Beefburger restaurant exterior"
            class="locations-img"
          />
        </div>
        <div class="locations-text reveal-right">
          <h2 class="locations-heading">Find Us</h2>
          <p class="locations-copy">Now open in cities near you.</p>
          <a href="/locations" class="btn btn-outline">Find a Location</a>
        </div>
      </div>
    </section>

    <!-- Loyalty Accord Teaser -->
    <section class="accord-teaser">
      <div class="section-inner accord-inner">

        <div class="accord-visual reveal-left">
          <div class="accord-receipt-stage">
            <div class="accord-receipt-wrap">
              <div class="accord-receipt-shadow" aria-hidden="true">
                <div class="accord-receipt-shadow-shape"></div>
              </div>
              <div class="accord-receipt" aria-hidden="true">
                <div class="accord-receipt-body">
                  <pre class="accord-receipt-text">================================
  MR. BEEFBURGER
================================
  THE BEEFBURGER
  LOYALTY ACCORD

A formal arrangement between
Gerald and the customer.
Since 2019.

--------------------------------
SAUCE UNIT RATES
--------------------------------
Every $1 Spent          1 SU
Visiting on Tuesday    +3 SU
Meaty Faced Burger     +5 SU
Joining the Accord    +10 SU
--------------------------------

Four tiers.
Named with gravity.
Gerald keeps records.

================================
** NOT A PUNCH CARD           **
** NOT A PROGRAM              **
** AN ACCORD                  **
================================</pre>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="accord-text reveal-right">
          <p class="accord-eyebrow">Membership</p>
          <div class="accord-heading-row">
            <img
              src="/images/mrbeefburger-icon-2026.png"
              alt=""
              class="accord-mascot"
              aria-hidden="true"
            />
            <h2 class="accord-heading">The Beefburger<br />Loyalty Accord</h2>
          </div>
          <p class="accord-sub">Not a program. Not a club. An Accord. Gerald drafted it himself. It took eleven months. You earn Sauce Units. Gerald tracks them personally.</p>
          <ul class="accord-perks">
            <li>Earn 1 Sauce Unit per dollar</li>
            <li>Four tiers, named with escalating gravity</li>
            <li>Gerald will eventually nod at you</li>
          </ul>
          <a href="/loyalty" class="btn accord-cta">Apply to the Accord</a>
        </div>

      </div>
    </section>

  </main>

  <noscript>
    <style>
      .reveal, .reveal-left, .reveal-right {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>
</Layout>

<script>
  const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
  const dots = document.querySelectorAll<HTMLButtonElement>('.hero-dot');
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    slides[current].classList.remove('active');
    dots[current].classList.remove('active');
    current = index;
    slides[current].classList.add('active');
    dots[current].classList.add('active');
  }

  function startTimer() {
    timer = setInterval(() => goTo((current + 1) % slides.length), 5000);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      clearInterval(timer);
      goTo(i);
      startTimer();
    });
  });

  startTimer();

  // Scroll / entrance animations — plain IntersectionObserver, no library.
  const revealEls = document.querySelectorAll<HTMLElement>('.reveal, .reveal-left, .reveal-right');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    revealEls.forEach(el => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
    );
    revealEls.forEach(el => io.observe(el));
  }
</script>

<style>
  /* ── Hero ─────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 82vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  /* Slides sit behind everything */
  .hero-slides {
    position: absolute;
    inset: 0;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1.5s ease;
  }

  .hero-slide.active {
    opacity: 1;
  }

  /* Dark gradient up from bottom for text legibility */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.72) 0%,
      rgba(0, 0, 0, 0.35) 35%,
      transparent 65%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 3rem 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  /* Slider dot/line controls */
  .hero-dots-rail {
    position: absolute;
    bottom: 2rem;
    left: 0;
    right: 0;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 3rem;
    display: flex;
    justify-content: flex-end;
    pointer-events: none;
  }

  .hero-dots {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    pointer-events: all;
  }

  .hero-dot {
    height: 4px;
    width: 8px;
    border-radius: 999px;
    border: none;
    padding: 0;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: width 0.35s ease, background 0.35s ease;
  }

  .hero-dot.active {
    width: 28px;
    background: #ffffff;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
  }

  .hero-overline {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.05;
    white-space: nowrap;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.5);
  }

  .btn-hero {
    display: inline-block;
    padding: 0.9rem 2.25rem;
    background-color: var(--color-red);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    border: 2px solid var(--color-red);
    transition: background-color 0.2s, color 0.2s;
    white-space: nowrap;
  }

  .btn-hero:hover {
    background-color: transparent;
    color: #ffffff;
    border-color: #ffffff;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 75vh;
    }

    .hero-inner {
      padding: 0 1.5rem 4rem;
      gap: 1.25rem;
    }

    .hero-headline {
      white-space: nowrap;
      font-size: clamp(0.9rem, 5.8vw, 2rem);
    }

    .hero-dots-rail {
      padding: 0 1.5rem;
      bottom: 1.5rem;
    }
  }

  /* ── Category Icons ───────────────────────── */
  .categories {
    background-color: var(--color-bg);
    padding: 4rem 0 0;
    position: relative;
    z-index: 2;
  }

  .categories-label {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    color: var(--color-text);
    text-align: center;
    /* Negative margin compensates for .category-grid's translateY overlap
       below, so the heading still sits close to the badges visually.
       This only pulls the grid up in normal flow before the transform
       pushes it back down — it doesn't change the transform itself, so
       the badges' overlap into the section below is unaffected. */
    margin: 0 0 -3rem;
  }

  .category-grid {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    flex-wrap: wrap;
    /* Nudged down so the badges spill over the section boundary and
       overlap the surface below — purely visual, doesn't affect flow.
       The curve rises close to flat right under this row, so this needs
       to push further than a flat boundary would suggest. */
    transform: translateY(6rem);
  }

  .category-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    transition: transform 0.25s;
  }

  .category-tile:hover {
    transform: translateY(-6px);
  }

  .category-icon {
    width: 112px;
    height: 112px;
    background: radial-gradient(circle at 34% 28%, #ffde5c 0%, var(--color-yellow) 62%, #e0ab00 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-shadow:
      0 0 0 6px var(--color-bg),
      0 14px 28px rgba(26, 26, 26, 0.18);
    transition: background 0.25s, box-shadow 0.25s;
  }

  .category-tile:hover .category-icon {
    background: radial-gradient(circle at 34% 28%, #ff6a52 0%, var(--color-red) 62%, #b81f15 100%);
    box-shadow:
      0 0 0 6px var(--color-bg),
      0 18px 34px rgba(218, 41, 28, 0.28);
  }

  .category-tile:hover .category-icon :global(svg path),
  .category-tile:hover .category-icon :global(svg rect),
  .category-tile:hover .category-icon :global(svg circle) {
    fill: var(--color-yellow);
  }

  .category-tile:hover .category-icon :global(svg line),
  .category-tile:hover .category-icon :global(svg path[stroke]) {
    stroke: var(--color-yellow);
  }

  .category-label {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  /* ── Featured Burger ──────────────────────── */
  .featured {
    position: relative;
    background-color: var(--color-surface);
    /* Extra top padding clears room for the category badges overlapping
       up from the section above, plus breathing room before the burger. */
    padding: 11.5rem 0 5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  /* Same hand-drawn swoop used under the wordmark, stretched into a
     full-width cap so the section opens on a curve instead of a hard line. */
  .featured-wave {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4rem;
    display: block;
  }

  .featured-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .featured-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }

  .featured-eyebrow {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-red);
    margin: 0 0 0.75rem;
  }

  .featured-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  .featured-desc {
    font-size: 1rem;
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0 0 2rem;
  }

  /* ── Signatures ──────────────────────────── */
  .signatures {
    background-color: var(--color-bg);
    padding: 5rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 2.5rem;
  }

  .sig-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .sig-card {
    text-decoration: none;
    background-color: var(--color-surface);
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.06);
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .sig-card:hover {
    box-shadow: 0 8px 24px rgba(218, 41, 28, 0.12);
    transform: translateY(-3px);
  }

  .sig-img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .sig-body {
    padding: 1.25rem;
  }

  .sig-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .sig-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Loyalty Accord Teaser ───────────────────── */
  .accord-teaser {
    background-color: #1a1a1a;
    padding: 6rem 0;
  }

  .accord-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  /* Visual column: receipt */
  .accord-visual {
    display: flex;
    justify-content: center;
  }

  .accord-receipt-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .accord-receipt-wrap {
    position: relative;
    transform: rotate(-3deg);
    z-index: 10;
  }

  .accord-receipt-shadow {
    position: absolute;
    inset: 0;
    filter: blur(8px);
  }

  .accord-receipt-shadow-shape {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    clip-path: polygon(
      0% 3%, 2.5% 0%, 5% 3%, 7.5% 0%, 10% 3%, 12.5% 0%, 15% 3%, 17.5% 0%, 20% 3%,
      22.5% 0%, 25% 3%, 27.5% 0%, 30% 3%, 32.5% 0%, 35% 3%, 37.5% 0%, 40% 3%,
      42.5% 0%, 45% 3%, 47.5% 0%, 50% 3%, 52.5% 0%, 55% 3%, 57.5% 0%, 60% 3%,
      62.5% 0%, 65% 3%, 67.5% 0%, 70% 3%, 72.5% 0%, 75% 3%, 77.5% 0%, 80% 3%,
      82.5% 0%, 85% 3%, 87.5% 0%, 90% 3%, 92.5% 0%, 95% 3%, 97.5% 0%, 100% 3%,
      100% 97%,
      97.5% 100%, 95% 97%, 92.5% 100%, 90% 97%, 87.5% 100%, 85% 97%, 82.5% 100%, 80% 97%,
      77.5% 100%, 75% 97%, 72.5% 100%, 70% 97%, 67.5% 100%, 65% 97%, 62.5% 100%, 60% 97%,
      57.5% 100%, 55% 97%, 52.5% 100%, 50% 97%, 47.5% 100%, 45% 97%, 42.5% 100%, 40% 97%,
      37.5% 100%, 35% 97%, 32.5% 100%, 30% 97%, 27.5% 100%, 25% 97%, 22.5% 100%, 20% 97%,
      17.5% 100%, 15% 97%, 12.5% 100%, 10% 97%, 7.5% 100%, 5% 97%, 2.5% 100%, 0% 97%
    );
  }

  .accord-receipt {
    position: relative;
    width: 264px;
    background: #f5f0e8;
    clip-path: polygon(
      0% 3%, 2.5% 0%, 5% 3%, 7.5% 0%, 10% 3%, 12.5% 0%, 15% 3%, 17.5% 0%, 20% 3%,
      22.5% 0%, 25% 3%, 27.5% 0%, 30% 3%, 32.5% 0%, 35% 3%, 37.5% 0%, 40% 3%,
      42.5% 0%, 45% 3%, 47.5% 0%, 50% 3%, 52.5% 0%, 55% 3%, 57.5% 0%, 60% 3%,
      62.5% 0%, 65% 3%, 67.5% 0%, 70% 3%, 72.5% 0%, 75% 3%, 77.5% 0%, 80% 3%,
      82.5% 0%, 85% 3%, 87.5% 0%, 90% 3%, 92.5% 0%, 95% 3%, 97.5% 0%, 100% 3%,
      100% 97%,
      97.5% 100%, 95% 97%, 92.5% 100%, 90% 97%, 87.5% 100%, 85% 97%, 82.5% 100%, 80% 97%,
      77.5% 100%, 75% 97%, 72.5% 100%, 70% 97%, 67.5% 100%, 65% 97%, 62.5% 100%, 60% 97%,
      57.5% 100%, 55% 97%, 52.5% 100%, 50% 97%, 47.5% 100%, 45% 97%, 42.5% 100%, 40% 97%,
      37.5% 100%, 35% 97%, 32.5% 100%, 30% 97%, 27.5% 100%, 25% 97%, 22.5% 100%, 20% 97%,
      17.5% 100%, 15% 97%, 12.5% 100%, 10% 97%, 7.5% 100%, 5% 97%, 2.5% 100%, 0% 97%
    );
  }

