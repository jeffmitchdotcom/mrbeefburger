---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { auth } from '../lib/auth';
import { db } from '../lib/db';
import { loyaltyMembers } from '../lib/schema';
import { eq } from 'drizzle-orm';

const allItems = (await getCollection('menu')).filter(
  item => item.data.available !== false && item.data.category === 'burgers'
);
const burgers = allItems.sort((a, b) => {
  if (a.data.signature && !b.data.signature) return -1;
  if (!a.data.signature && b.data.signature) return 1;
  return a.data.title.localeCompare(b.data.title);
});

const session = await auth.api.getSession({ headers: Astro.request.headers });
const user = session?.user ?? null;
let isAccordMember = false;
if (user?.email) {
  const [member] = await db
    .select({ id: loyaltyMembers.id })
    .from(loyaltyMembers)
    .where(eq(loyaltyMembers.email, user.email.toLowerCase().trim()))
    .limit(1);
  isAccordMember = !!member;
}
---

<Layout title="Loyalty — Mr. Beefburger">
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet" />

  <div id="accord-context-bar" style="display:none;position:fixed;top:90px;left:0;right:0;z-index:90;background:#1a1a1a;color:#ffffff;padding:0.625rem 1.5rem;font-family:var(--font-body);font-size:0.8rem;text-align:center;border-bottom:2px solid #F5C200;">
    <span id="accord-context-text"></span>
  </div>

  <main>

    <!-- ── Hero ────────────────────────────────────────────── -->
    <section class="hero">
      <div class="hero-inner">
        <p class="section-label">Membership</p>
        <h1 class="hero-title">The Beefburger<br />Loyalty Accord</h1>
        <p class="hero-sub">Not a program. Not a club. An Accord. Gerald drafted it himself. It took eleven months.</p>
      </div>
    </section>

    <!-- ── Sauce Units ─────────────────────────────────────── -->
    <section class="sauce-section">
      <div class="sauce-inner">

        <div class="sauce-content">
          <p class="section-label">The Currency</p>
          <h2 class="section-heading">Sauce Units</h2>
          <p class="sauce-intro">Points are called Sauce Units. All transactions within the Accord are denominated in Sauce Units. Gerald does not round up. He does not round down. He calculates precisely.</p>
          <blockquote class="sauce-quote">"You have earned Sauce Units. Gerald is aware."</blockquote>

          <ul class="earning-list">
            <li class="earning-item">
              <div class="earning-info">
                <span class="earning-label">Every Purchase</span>
                <span class="earning-desc">The baseline. The floor. The non-negotiable.</span>
              </div>
              <span class="earning-su">1 SU / $1</span>
            </li>
            <li class="earning-item">
              <div class="earning-info">
                <span class="earning-label">Ordering the Meaty Faced Sauce Burger</span>
                <span class="earning-desc">The Original. Gerald considers this a correct decision.</span>
              </div>
              <span class="earning-su">+5 SU</span>
            </li>
            <li class="earning-item">
              <div class="earning-info">
                <span class="earning-label">Visiting on a Tuesday</span>
                <span class="earning-desc">Gerald's Day. No further explanation is given.</span>
              </div>
              <span class="earning-su">+3 SU</span>
            </li>
            <li class="earning-item">
              <div class="earning-info">
                <span class="earning-label">Completing the Application with Honest Answers</span>
                <span class="earning-desc">One time only. Gerald will know.</span>
              </div>
              <span class="earning-su">+10 SU</span>
            </li>
            <li class="earning-item">
              <div class="earning-info">
                <span class="earning-label">Referring Someone Who Joins</span>
                <span class="earning-desc">The Propagation. Gerald respects it.</span>
              </div>
              <span class="earning-su">+15 SU</span>
            </li>
          </ul>
        </div>

        <!-- The Receipt (desktop: absolute float; mobile: static) -->
        <div class="receipt-container">
          <div class="receipt-shadow" aria-hidden="true">
            <div class="receipt-shadow-shape"></div>
          </div>
          <div class="receipt" aria-hidden="true">
          <div class="receipt-body">
            <pre class="receipt-text">================================
   MR. BEEFBURGER
   HOME OF THE MEATY FACED
   SAUCE BURGER
================================

SAUCE UNIT STATEMENT
Member Since: 03/14/2022
Tier: THE COMMITTED

--------------------------------
ACTIVITY SUMMARY
--------------------------------
Burgers Consumed:         14
Tuesdays Honored:          3
SU Earned (Total):       247
SU Redeemed:              40
SU Balance:              207
--------------------------------

CURRENT STATUS:
  THE COMMITTED

NEXT TIER:
  THE CONSECRATED
  (293 SU REQUIRED)

--------------------------------
Gerald has been informed.
--------------------------------

** THIS IS NOT A RECEIPT **
** THIS IS A RECORD       **
** THERE IS A DIFFERENCE  **

================================
Thank you for your continued
participation in the Accord.
================================</pre>
          </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ── Tier System ─────────────────────────────────────── -->
    <section class="tiers-section">
      <div class="tiers-inner">
        <p class="section-label">The Structure</p>
        <h2 class="section-heading">The Four Tiers</h2>
        <p class="tiers-intro">Four tiers. Named with escalating gravity. No discount percentages. No exclamation points.</p>
        <div class="tiers-grid">

          <div class="tier-card">
            <span class="tier-number">Tier 01</span>
            <h3 class="tier-name">The Initiated</h3>
            <p class="tier-range">0–199 Sauce Units</p>
            <p class="tier-badge">"You have arrived."</p>
          </div>

          <div class="tier-card">
            <span class="tier-number">Tier 02</span>
            <h3 class="tier-name">The Committed</h3>
            <p class="tier-range">200–499 Sauce Units</p>
            <p class="tier-badge">"Gerald has been informed."</p>
          </div>

          <div class="tier-card">
            <span class="tier-number">Tier 03</span>
            <h3 class="tier-name">The Consecrated</h3>
            <p class="tier-range">500–999 Sauce Units</p>
            <p class="tier-badge">"Something has shifted."</p>
          </div>

          <div class="tier-card tier-card--dark">
            <div class="tier-card-header">
              <span class="tier-number">Tier 04</span>
              <span class="tier-pinnacle-badge">✦ Pinnacle</span>
            </div>
            <h3 class="tier-name">The Beefborn</h3>
            <p class="tier-range">1,000+ Sauce Units</p>
            <p class="tier-badge">"There is no going back."</p>
          </div>

        </div>
      </div>
    </section>

    <!-- ── Perks + The Card ────────────────────────────────── -->
    <section class="perks-section">
      <div class="perks-inner">

        <!-- The Card (desktop: absolute float; mobile: static block) -->
        <div class="loyalty-card" aria-hidden="true">
          <span class="card-brand">Mr. Beefburger</span>
          <div class="card-stripe"></div>
          <span class="card-word">KNOWN</span>
          <div class="card-bottom">
            <span class="card-tier">The Consecrated</span>
            <span class="card-number">0047</span>
          </div>
        </div>

        <div class="perks-content">
          <p class="section-label">The Privileges</p>
          <h2 class="section-heading">Perks by Tier</h2>
          <p class="card-copy">The Card is issued upon joining. It contains no points balance. It contains no expiration date. It contains one word. That word is sufficient.</p>
          <p class="perks-intro">Perks are not discounts. They are privileges. They are extended with sincerity and received accordingly.</p>

          <div class="perks-list">

            <details class="perk-block" open>
              <summary class="perk-summary">
                <span class="perk-tier-name">The Initiated</span>
                <span class="perk-su-range">0–199 SU</span>
              </summary>
              <ul class="perk-items">
                <li>Priority seating in the third booth from the restrooms. The booth with the USDA letter.</li>
                <li>Your name is entered into the Register. The Register is not digital. Gerald keeps it in a drawer.</li>
                <li>Access to the sauce in the standard vessel.</li>
              </ul>
            </details>

            <details class="perk-block">
              <summary class="perk-summary">
                <span class="perk-tier-name">The Committed</span>
                <span class="perk-su-range">200–499 SU</span>
              </summary>
              <ul class="perk-items">
                <li>A formal acknowledgment from Gerald. Not a thank-you. An acknowledgment.</li>
                <li>Access to the Thursday menu. Gerald does not explain the Thursday menu.</li>
                <li>Your name is now known to someone in the kitchen. They will not use it. But they know.</li>
              </ul>
            </details>

            <details class="perk-block">
              <summary class="perk-summary">
                <span class="perk-tier-name">The Consecrated</span>
                <span class="perk-su-range">500–999 SU</span>
              </summary>
              <ul class="perk-items">
                <li>Access to the sauce in a slightly larger vessel.</li>
                <li>A private telephone number. It rings twice and then goes silent. This is normal.</li>
                <li>Your photograph is considered for the wall. Gerald curates the wall personally. Not every photograph makes it.</li>
              </ul>
            </details>

            <details class="perk-block perk-block--dark">
              <summary class="perk-summary">
                <span class="perk-tier-name">The Beefborn</span>
                <span class="perk-su-range">1,000+ SU</span>
              </summary>
              <ul class="perk-items">
                <li>A standing reservation. Not for a specific time. Just a reservation. It exists.</li>
                <li>Access to the Beefborn menu. There is one item. It changes monthly. Gerald has never described it in writing.</li>
                <li>Gerald will, upon your next visit, nod at you. You will know what it means.</li>
              </ul>
            </details>

          </div>
        </div>

      </div>
    </section>

    <!-- ── The Application ─────────────────────────────────── -->
    <section class="app-section" id="join-accord">
      <div class="app-inner">
        <p class="section-label">The Application</p>

        {isAccordMember ? (
          <>
            <h2 class="section-heading">You're Already In</h2>
            <p class="app-intro">Gerald is not accepting a second application. He does not need to.</p>
            <div class="app-document">
              <div class="app-doc-header">
                <h3 class="app-doc-title">Application to the Beefburger Loyalty Accord</h3>
                <p class="app-doc-sub">Status: Enrolled. This matter is closed.</p>
              </div>
              <div style="padding: 1rem 0 0.5rem; display: flex; flex-direction: column; gap: 1rem;">
                <p style="font-family: var(--font-body); font-size: 0.95rem; color: var(--color-text); line-height: 1.8; margin: 0;">
                  Your enrollment is on record. Gerald is aware. He has been since you joined.
                </p>
                <p style="font-family: var(--font-body); font-size: 0.95rem; color: var(--color-text); line-height: 1.8; margin: 0;">
                  You cannot apply a second time. This is not a limitation. It is a rule. Submitting a second application does not earn additional Sauce Units. It earns Gerald's awareness that you tried, which is a different thing entirely.
                </p>
                <p style="font-family: var(--font-body); font-size: 0.95rem; color: var(--color-muted); line-height: 1.8; margin: 0; font-style: italic;">
                  Your Sauce Unit balance and order history are in your account.
                </p>
                <a href="/account" style="display: inline-block; align-self: flex-start; background: var(--color-red); color: #ffffff; text-decoration: none; border-radius: 6px; padding: 0.75rem 1.5rem; font-family: var(--font-body); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-top: 0.5rem;">
                  View My Account →
                </a>
              </div>
            </div>
          </>
        ) : (
          <>
            <h2 class="section-heading">Join the Accord</h2>
            <p class="app-intro">The Accord is not difficult to join. It is simply formal. Gerald believes formality is a sign of respect. Complete the following with accuracy and sincerity.</p>

        <div class="app-document">

          <div class="app-doc-header">
            <h3 class="app-doc-title">Application to the Beefburger Loyalty Accord</h3>
            <p class="app-doc-sub">All fields are reviewed personally. Some answers have moved Gerald. Not many. But some.</p>
          </div>

          <form class="app-form" id="app-form">

            <div class="field-group">
              <label class="field-label" for="legal-name">Full Legal Name</label>
              <p class="field-note">As it appears on government-issued documentation. Gerald will verify nothing. But he will know.</p>
              <input type="text" id="legal-name" name="legal-name" class="field-input" required />
            </div>

            <div class="field-group">
              <label class="field-label" for="email">Email Address</label>
              <p class="field-note">For Accord correspondence only. Gerald does not send newsletters. He considers them beneath the relationship.</p>
              <input type="email" id="email" name="email" class="field-input" required />
            </div>

            <div class="field-group">
              <label class="field-label" for="city">City of Residence</label>
              <p class="field-note">Gerald keeps a personal atlas. He maintains it by hand.</p>
              <input type="text" id="city" name="city" class="field-input" required />
            </div>

            <div class="field-group">
              <label class="field-label" for="burger">Preferred Burger</label>
              <p class="field-note">Your answer is noted. If you select something from the chicken section, your application will still be processed. Gerald will simply be aware.</p>
              <select id="burger" name="burger" class="field-input field-select" required>
                {burgers.map(item => (
                  <option value={item.data.title}>{item.data.title}</option>
                ))}
              </select>
            </div>

            <div class="field-group">
              <label class="field-label" for="beef-relationship">Describe Your Relationship With Beef</label>
              <p class="field-note">Three sentences maximum. Gerald reads these. Some have moved him.</p>
              <textarea id="beef-relationship" name="beef-relationship" class="field-input field-textarea" rows="4" required></textarea>
            </div>

            <div class="field-group">
              <fieldset class="field-fieldset">
                <legend class="field-label">Have you ever ordered a burger well-done?</legend>
                <p class="field-note">This answer is recorded.</p>
                <div class="radio-group">
                  <label class="radio-label"><input type="radio" name="well-done" value="yes" /> Yes</label>
                  <label class="radio-label"><input type="radio" name="well-done" value="no" checked /> No</label>
                </div>
              </fieldset>
            </div>

            <input type="hidden" id="loyalty-order-ref" name="order-number" />
            <div style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
              <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
            </div>
            <button type="submit" class="app-submit">Submit Application to the Accord</button>
            <p class="app-error" id="app-error">The Accord encountered a difficulty. Gerald is looking into it.</p>
            <p class="app-error" id="app-error-duplicate">You are already enrolled in the Accord. Gerald has your record. Attempting to join twice does not earn additional Sauce Units. Gerald checked.</p>

          </form>

          <div class="app-success" id="app-success">
            <p>Your application has been received.</p>
            <p>Gerald will not reply. This is not a slight. It is procedure.</p>
            <p>Your Sauce Units have been credited.</p>
            <p class="app-success-tier">Welcome to The Initiated.</p>
            <p class="app-success-member">Member No. <span id="app-success-member-id">—</span></p>
          </div>

        </div>
          </>
        )}
      </div>
    </section>

  </main>
</Layout>

<script>
  // Handle prefill from a just-placed order (checkout → Accord flow)
  const prefillRaw = sessionStorage.getItem('loyaltyPrefill');
  if (prefillRaw) {
    try {
      const prefill = JSON.parse(prefillRaw);
      sessionStorage.removeItem('loyaltyPrefill');

      if (prefill.email) {
        const emailInput = document.getElementById('email') as HTMLInputElement;
        if (emailInput) {
          emailInput.value = prefill.email;
          emailInput.readOnly = true;
          emailInput.style.background = '#ebebeb';
          emailInput.style.color = '#888888';
          emailInput.style.pointerEvents = 'none';
        }
      }

      if (prefill.orderNumber) {
        const orderRefInput = document.getElementById('loyalty-order-ref') as HTMLInputElement;
        if (orderRefInput) orderRefInput.value = prefill.orderNumber;

        const contextBar = document.getElementById('accord-context-bar') as HTMLElement;
        const contextText = document.getElementById('accord-context-text') as HTMLElement;
        if (contextBar && contextText) {
          contextText.textContent = `Order ${prefill.orderNumber} is placed. Complete your application and Gerald will credit your Sauce Units.`;
          contextBar.style.display = 'block';
          document.body.style.paddingTop = '2.5rem';
        }
      }

      const section = document.getElementById('join-accord');
      if (section) setTimeout(() => section.scrollIntoView({ behavior: 'smooth' }), 100);
    } catch {
      // malformed prefill — proceed normally
    }
  }

  const form = document.getElementById('app-form') as HTMLFormElement;
  const success = document.getElementById('app-success') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    document.getElementById('app-error')!.style.display = 'none';
    document.getElementById('app-error-duplicate')!.style.display = 'none';
    const data = Object.fromEntries(new FormData(form));
    try {
      const res = await fetch('/api/loyalty', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: data['legal-name'],
          email: data['email'],
          city: data['city'],
          preferredBurger: data['burger'],
          beefRelationship: data['beef-relationship'],
          wellDone: data['well-done'],
          orderNumber: data['order-number'] || undefined,
        }),
      });
      if (res.status === 409) {
        document.getElementById('app-error-duplicate')!.style.display = 'block';
        return;
      }
      if (!res.ok) throw new Error();
      const { memberId, orderSauceUnits } = await res.json();

      const memberIdEl = document.getElementById('app-success-member-id');
      if (memberIdEl && memberId) memberIdEl.textContent = String(memberId).padStart(4, '0');

      // Update success message if retroactive SU were credited
      if (orderSauceUnits && orderSauceUnits > 0) {
        const suLine = success.querySelector('p:nth-child(3)');
        if (suLine) suLine.textContent = `Your Sauce Units have been credited — 10 for joining, ${orderSauceUnits} for your order. Gerald is keeping score.`;
      }

      // Dismiss context bar on success
      const contextBar = document.getElementById('accord-context-bar') as HTMLElement;
      if (contextBar) contextBar.style.display = 'none';

      form.style.display = 'none';
      success.style.display = 'block';
    } catch {
      document.getElementById('app-error')!.style.display = 'block';
    }
  });

  const perkBlocks = document.querySelectorAll<HTMLDetailsElement>('.perk-block');
  perkBlocks.forEach(block => {
    block.addEventListener('toggle', () => {
      if (block.open) {
        perkBlocks.forEach(other => { if (other !== block) other.open = false; });
      }
    });
  });
</script>

<style>
  /* ── Shared typography helpers ──────────────────────────── */
  .section-label {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-red);
    margin: 0 0 0.5rem;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--color-text);
    margin: 0 0 1.25rem;
    line-height: 1.1;
  }

  /* ── Hero ────────────────────────────────────────────────── */
  .hero {
    background-color: var(--color-surface);
    background-image: url('/images/mrbeefburger-hero-1.jpg');
    background-size: cover;
    background-position: center;
    position: relative;
    padding: 5rem 1.5rem;
    border-bottom: 1px solid rgba(218, 41, 28, 0.15);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-surface);
    opacity: 0.85;
  }

  .hero-inner {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6.5vw, 4.75rem);
    font-weight: 800;
    color: var(--color-red);
    margin: 0.25rem 0 1rem;
    line-height: 1.03;
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: 1.125rem;
    color: var(--color-muted);
    font-style: italic;
    margin: 0;
    max-width: 520px;
    line-height: 1.7;
  }

  /* ── Sauce Units ─────────────────────────────────────────── */
  .sauce-section {
    background-color: var(--color-bg);
    padding: 5rem 1.5rem 6rem;
  }

  .sauce-inner {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    min-height: 680px;
  }

  .sauce-content {
    max-width: 580px;
  }

  .sauce-intro {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.8;
    margin: 0 0 1rem;
  }

  .sauce-quote {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-muted);
    border-left: 3px solid var(--color-red);
    padding-left: 1rem;
    margin: 1.5rem 0 2rem;
  }

  .earning-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .earning-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .earning-item:last-child {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .earning-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .earning-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .earning-desc {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--color-muted);
    font-style: italic;
  }

  .earning-su {
    font-family: 'Courier New', Courier, monospace;
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--color-red);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── The Receipt ─────────────────────────────────────────── */
  .receipt-container {
    position: absolute;
    right: 0;
    top: 1.5rem;
    width: 320px;
    transform: rotate(3deg);
    z-index: 10;
  }

  .receipt-shadow {
    position: absolute;
    inset: 0;
    filter: blur(8px);
  }

  .receipt-shadow-shape {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.17);
    clip-path: polygon(
      0% 3%, 2.5% 0%, 5% 3%, 7.5% 0%, 10% 3%, 12.5% 0%, 15% 3%, 17.5% 0%, 20% 3%,
      22.5% 0%, 25% 3%, 27.5% 0%, 30% 3%, 32.5% 0%, 35% 3%, 37.5% 0%, 40% 3%,
      42.5% 0%, 45% 3%, 47.5% 0%, 50% 3%, 52.5% 0%, 55% 3%, 57.5% 0%, 60% 3%,
      62.5% 0%, 65% 3%, 67.5% 0%, 70% 3%, 72.5% 0%, 75% 3%, 77.5% 0%, 80% 3%,
