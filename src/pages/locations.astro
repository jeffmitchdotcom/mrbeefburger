---
import Layout from '../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

interface Location {
  slug: string;
  name: string;
  address: string;
  city: string;
  state: string;
  lat: number;
  lng: number;
  hours: string;
  phone: string;
}

interface MapLocation {
  slug: string;
  name: string;
  address: string;
  lat: number;
  lng: number;
}

const entries = await getCollection('locations');
const locations: Location[] = entries
  .map((e: CollectionEntry<'locations'>): Location => ({ slug: e.id.replace(/\.md$/, ''), ...e.data }))
  .sort((a: Location, b: Location) => a.city.localeCompare(b.city));

const mapLocations: MapLocation[] = locations.map(l => ({
  slug: l.slug,
  name: l.name,
  address: `${l.address}, ${l.city}, ${l.state}`,
  lat: l.lat,
  lng: l.lng,
}));
---

<Layout>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  </Fragment>

  <main>
    <!-- Hero -->
    <section class="page-hero">
      <div class="page-hero-inner">
        <h1 class="page-title">Find a Mr. Beefburger</h1>
        <p class="page-sub">We're coming to a city near you. One day.</p>
      </div>
    </section>

    <!-- Map -->
    <section class="map-section">
      <div id="map"></div>
    </section>

    <!-- Location Cards -->
    <section class="locs-section">
      <div class="section-inner">
        <div class="locs-grid">
          {locations.map((loc: Location) => (
            <div
              class="loc-card"
              id={`loc-${loc.slug}`}
              data-lat={loc.lat}
              data-lng={loc.lng}
              data-slug={loc.slug}
            >
              <div class="loc-card-top">
                <h2 class="loc-name">{loc.name}</h2>
                <span class="loc-badge">{loc.state}</span>
              </div>
              <address class="loc-address">
                {loc.address}<br />{loc.city}, {loc.state}
              </address>
              <dl class="loc-details">
                <div class="loc-detail-row">
                  <dt>Hours</dt>
                  <dd>{loc.hours}</dd>
                </div>
                <div class="loc-detail-row">
                  <dt>Phone</dt>
                  <dd><a href={`tel:${loc.phone.replace(/\D/g,'')}`}>{loc.phone}</a></dd>
                </div>
              </dl>
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${loc.address}, ${loc.city}, ${loc.state}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline"
              >
                Get Directions
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script define:vars={{ mapLocations }} is:inline>
  const map = L.map('map', { zoomControl: true }).setView([38.5, -96], 4);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    maxZoom: 18,
  }).addTo(map);

  const pinIcon = L.divIcon({
    html: `<div class="map-pin"></div>`,
    iconSize: [22, 22],
    iconAnchor: [11, 11],
    popupAnchor: [0, -14],
    className: '',
  });

  const markers = {};

  mapLocations.forEach(loc => {
    const marker = L.marker([loc.lat, loc.lng], { icon: pinIcon })
      .addTo(map)
      .bindPopup(`<strong>${loc.name}</strong><br><span style="font-size:0.85rem;color:#555">${loc.address}</span>`);

    marker.on('click', () => {
      const card = document.getElementById(`loc-${loc.slug}`);
      if (card) {
        document.querySelectorAll('.loc-card').forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    markers[loc.slug] = marker;
  });

  document.querySelectorAll('.loc-card').forEach(card => {
    card.addEventListener('click', () => {
      const slug = card.dataset.slug;
      const lat = parseFloat(card.dataset.lat);
      const lng = parseFloat(card.dataset.lng);
      document.querySelectorAll('.loc-card').forEach(c => c.classList.remove('active'));
      card.classList.add('active');
      map.setView([lat, lng], 13, { animate: true });
      if (markers[slug]) markers[slug].openPopup();
    });
  });
</script>

<style>
  /* ── Page Hero ────────────────────────────── */
  .page-hero {
    background-color: var(--color-surface);
    padding: 4rem 1.5rem;
    border-bottom: 1px solid rgba(218, 41, 28, 0.15);
  }

  .page-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--color-red);
    margin: 0 0 0.5rem;
    line-height: 1;
  }

  .page-sub {
    font-size: 1.0625rem;
    color: var(--color-muted);
    font-style: italic;
    margin: 0;
  }

  /* ── Map ──────────────────────────────────── */
  .map-section {
    width: 100%;
    border-bottom: 3px solid var(--color-red);
  }

  #map {
    width: 100%;
    height: 480px;
  }

  /* Custom map pin */
  :global(.map-pin) {
    width: 22px;
    height: 22px;
    background-color: var(--color-red);
    border: 3px solid #fff;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0,0,0,0.35);
    cursor: pointer;
  }

  /* ── Location Cards ───────────────────────── */
  .locs-section {
    padding: 4rem 0;
    background-color: var(--color-bg);
  }

  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .locs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .loc-card {
    background-color: var(--color-surface);
    border: 2px solid transparent;
    border-radius: 6px;
    padding: 1.5rem;
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .loc-card:hover,
  .loc-card.active {
    border-color: var(--color-red);
    box-shadow: 0 4px 20px rgba(218, 41, 28, 0.12);
  }

  .loc-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .loc-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    line-height: 1.3;
  }

  .loc-badge {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background-color: var(--color-yellow);
    color: var(--color-text);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .loc-address {
    font-style: normal;
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .loc-details {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .loc-detail-row {
    display: flex;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .loc-detail-row dt {
    font-weight: 700;
    color: var(--color-text);
    min-width: 50px;
  }

  .loc-detail-row dd {
    margin: 0;
    color: var(--color-muted);
  }

  .loc-detail-row a {
    color: var(--color-red);
    text-decoration: none;
  }

  .loc-detail-row a:hover {
    text-decoration: underline;
  }

  .btn {
    display: inline-block;
    padding: 0.625rem 1.25rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    border: 2px solid var(--color-red);
    transition: background-color 0.2s, color 0.2s;
    text-align: center;
    align-self: flex-start;
  }

  .btn-outline {
    background-color: transparent;
    color: var(--color-red);
  }

  .btn-outline:hover {
    background-color: var(--color-red);
    color: #ffffff;
  }

  /* ── Responsive ───────────────────────────── */
  @media (max-width: 900px) {
    .locs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    #map {
      height: 320px;
    }

    .locs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
