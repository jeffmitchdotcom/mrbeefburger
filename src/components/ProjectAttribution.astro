---
// Byline + tech stack shown on /order/[id] (receipt) and /about.
// Content lives in src/content/site/attribution.json — edit it in Keystatic
// (Singletons → Project Attribution) or by hand.
import { getEntry } from 'astro:content';

const attribution = await getEntry('site', 'attribution');
if (!attribution) throw new Error('Missing src/content/site/attribution.json');
const { author, url, description, technologies } = attribution.data;
const urlLabel = new URL(url).hostname.replace(/^www\./, '');
---

<div class="attribution">
  <p class="attr-byline">
    A demo project by <a href={url} target="_blank" rel="noopener noreferrer" class="attr-link">{author}</a>
    &nbsp;·&nbsp;
    <a href={url} target="_blank" rel="noopener noreferrer" class="attr-link">{urlLabel}</a>
  </p>
  <p class="attr-desc">{description}</p>
  <div class="tech-stack">
    {technologies.map((tech) => (
      <span class="tech-badge"><span class="tech-dot" style={`background:${tech.color}`}></span>{tech.name}</span>
    ))}
  </div>
</div>

<style>
  .attribution {
    width: 100%;
    padding-top: 2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    text-align: center;
  }

  .attr-byline {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0 0 0.5rem;
  }

  .attr-link {
    color: var(--color-red);
    font-weight: 700;
    text-decoration: none;
  }

  .attr-link:hover {
    text-decoration: underline;
  }

  .attr-desc {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.75rem;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .tech-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
